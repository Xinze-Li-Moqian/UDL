module

public import ShallowNetwork.UniversalApproximation.OneInput
public import Mathlib.Topology.ContinuousMap.StoneWeierstrass
public import Mathlib.Analysis.SpecialFunctions.Exp

/-!
# Ridge functions

A ridge function on `ℝ^Dᵢ` has the form `x ↦ φ (∑ i, w i * x i)`: it varies only
along the direction `w`. Every hidden unit of a multi-input network is one.

`Approximable K f` says that shallow ReLU networks approximate `f` uniformly on
`K`. Approximable functions are closed under sums and scalar multiples, and
`Approximable.ridge` shows that every ridge function with a continuous profile
is approximable: the one-input theorem approximates `φ` on the compact image of
`K`, and `MultiInput.ReLURepresentable.comp_linear` turns that one-input network
into a multi-input one.

The exponential ridges `x ↦ exp (∑ i, w i * x i)` are closed under products,
since `exp (v · x) * exp (w · x) = exp ((v + w) · x)`. The algebra they generate
is therefore just their linear span, and it separates points. This is the
algebra fed to the Stone–Weierstrass theorem.
-/

@[expose] public section

namespace NeuralNetworks.MultiInput

/-- `f` is uniformly approximated on `K` by shallow ReLU networks. -/
def Approximable {Dᵢ : ℕ} (K : Set (Fin Dᵢ → ℝ)) (f : (Fin Dᵢ → ℝ) → ℝ) : Prop :=
  ∀ ε, 0 < ε → ∃ F, ReLURepresentable F ∧ ∀ x ∈ K, |F x - f x| < ε

namespace Approximable

variable {Dᵢ : ℕ} {K : Set (Fin Dᵢ → ℝ)}

/-- The zero function is approximable. -/
theorem zero : Approximable K fun _ => 0 := fun ε hε =>
  ⟨_, ReLURepresentable.const 0, fun x _ => by simpa using hε⟩

/-- Sums of approximable functions are approximable. -/
theorem add {f g : (Fin Dᵢ → ℝ) → ℝ} (hf : Approximable K f) (hg : Approximable K g) :
    Approximable K fun x => f x + g x := fun ε hε => by
  obtain ⟨F, hF, hFf⟩ := hf (ε / 2) (by linarith)
  obtain ⟨G, hG, hGg⟩ := hg (ε / 2) (by linarith)
  refine ⟨_, hF.add hG, fun x hx => ?_⟩
  have h₁ := hFf x hx
  have h₂ := hGg x hx
  rw [abs_lt] at *
  constructor <;> linarith [h₁.1, h₁.2, h₂.1, h₂.2]

/-- Scalar multiples of approximable functions are approximable. -/
theorem mul_left {f : (Fin Dᵢ → ℝ) → ℝ} (c : ℝ) (hf : Approximable K f) :
    Approximable K fun x => c * f x := fun ε hε => by
  have hc : 0 < |c| + 1 := by positivity
  obtain ⟨F, hF, hFf⟩ := hf (ε / (|c| + 1)) (div_pos hε hc)
  refine ⟨_, hF.mul_left c, fun x hx => ?_⟩
  rw [← mul_sub, abs_mul]
  calc |c| * |F x - f x| ≤ |c| * (ε / (|c| + 1)) :=
        mul_le_mul_of_nonneg_left (hFf x hx).le (abs_nonneg c)
    _ < (|c| + 1) * (ε / (|c| + 1)) := by
        apply mul_lt_mul_of_pos_right (by linarith) (div_pos hε hc)
    _ = ε := by field_simp

/-- A ridge function `φ (∑ i, w i * x i)` with continuous profile `φ` is approximable:
apply the one-input theorem to `φ` on the compact image of `K`. -/
theorem ridge (hK : IsCompact K) (w : Fin Dᵢ → ℝ) {φ : ℝ → ℝ} (hφ : Continuous φ) :
    Approximable K fun x => φ (∑ i, w i * x i) := fun ε hε => by
  have hlin : Continuous fun x : Fin Dᵢ → ℝ => ∑ i, w i * x i := by fun_prop
  obtain ⟨D, Φ, hΦ⟩ := universalApproximation _ (hK.image hlin) φ hφ.continuousOn ε hε
  exact ⟨_, ReLURepresentable.comp_linear Φ w, fun x hx => hΦ _ ⟨x, hx, rfl⟩⟩

end Approximable

/-- The exponential ridge function `x ↦ exp (∑ i, w i * x i)`. -/
noncomputable def expRidge {Dᵢ : ℕ} (w : Fin Dᵢ → ℝ) : C(Fin Dᵢ → ℝ, ℝ) :=
  ⟨fun x => Real.exp (∑ i, w i * x i), by fun_prop⟩

/-- Products of exponential ridges are exponential ridges. -/
theorem expRidge_mul {Dᵢ : ℕ} (v w : Fin Dᵢ → ℝ) :
    expRidge v * expRidge w = expRidge (v + w) := by
  ext x
  simp [expRidge, ← Real.exp_add, ← Finset.sum_add_distrib, add_mul]

/-- The algebra generated by exponential ridge functions. -/
noncomputable def expRidgeAlgebra (Dᵢ : ℕ) : Subalgebra ℝ C(Fin Dᵢ → ℝ, ℝ) :=
  Algebra.adjoin ℝ (Set.range expRidge)

/-- Coordinate exponentials `exp (x i)` already separate points. -/
theorem expRidgeAlgebra_separatesPoints (Dᵢ : ℕ) :
    (expRidgeAlgebra Dᵢ).SeparatesPoints := by
  intro x y hxy
  obtain ⟨i, hi⟩ := Function.ne_iff.mp hxy
  refine ⟨_, ⟨expRidge (Pi.single i 1), Algebra.subset_adjoin ⟨_, rfl⟩, rfl⟩, ?_⟩
  simpa [expRidge, Pi.single_apply] using hi

/-- Every element of the exponential ridge algebra is a linear combination of
exponential ridge functions, since their products are again exponential ridges. -/
theorem expRidgeAlgebra_eq_span (Dᵢ : ℕ) :
    Subalgebra.toSubmodule (expRidgeAlgebra Dᵢ) = Submodule.span ℝ (Set.range expRidge) := by
  apply Algebra.adjoin_eq_span_of_subset
  intro f hf
  apply Submodule.subset_span
  induction hf using Submonoid.closure_induction with
  | mem f hf => exact hf
  | one => exact ⟨0, by ext x; simp [expRidge]⟩
  | mul f g _ _ hf hg =>
    obtain ⟨v, rfl⟩ := hf
    obtain ⟨w, rfl⟩ := hg
    exact ⟨v + w, (expRidge_mul v w).symm⟩

/-- Every element of the exponential ridge algebra is approximable on a compact set. -/
theorem approximable_of_mem {Dᵢ : ℕ} {K : Set (Fin Dᵢ → ℝ)} (hK : IsCompact K)
    {f : C(Fin Dᵢ → ℝ, ℝ)} (hf : f ∈ expRidgeAlgebra Dᵢ) : Approximable K f := by
  have hf' : f ∈ Submodule.span ℝ (Set.range expRidge) := by
    rw [← expRidgeAlgebra_eq_span]; exact hf
  clear hf
  induction hf' using Submodule.span_induction with
  | mem f hf =>
    obtain ⟨w, rfl⟩ := hf
    exact Approximable.ridge hK w Real.continuous_exp
  | zero => exact Approximable.zero
  | add f g _ _ hf hg => exact hf.add hg
  | smul c f _ hf => exact hf.mul_left c

end NeuralNetworks.MultiInput
